# ── OpenAI (the only place credentials live — never hardcode elsewhere) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=400
OPENAI_BASE_URL=

# true  = full 3-tier validation incl. live API probe at startup
# false = static validation only; LLM tools degrade to deterministic fallbacks
LLM_VALIDATE_ON_STARTUP=false

LOG_LEVEL=INFO

# ── Observability (optional — empty keys fall back to logs/interactions.log) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Safety guardrails (blueprint §4) ──
SAFETY_BLOCK_PII=true
SAFETY_BLOCK_PROMPT_INJECTION=true
SAFETY_CHECK_OUTPUT_TOXICITY=true
